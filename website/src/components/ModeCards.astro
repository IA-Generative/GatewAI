---
const modes = [
  {
    title: 'Async',
    endpoint: 'POST /jobs/{type}',
    description: 'Large files, long tasks (>30s), result via webhook.',
  },
  {
    title: 'Sync',
    endpoint: 'POST /v1/*',
    description: 'OpenAI SDK, low latency, direct response.',
  },
  {
    title: 'LLM proxy',
    endpoint: 'POST /v1/* + provider',
    description: 'OpenAI · Anthropic · Ollama · vLLM with Redis cache and metrics.',
  },
];
---

<div class="mode-cards">
  {modes.map((m) => (
    <div class="mode-card">
      <span class="mode-title">{m.title}</span>
      <code class="mode-endpoint">{m.endpoint}</code>
      <p class="mode-desc">{m.description}</p>
    </div>
  ))}
</div>
