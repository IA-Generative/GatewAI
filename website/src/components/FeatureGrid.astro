---
import { Icon } from '@astrojs/starlight/components';

const features = [
  {
    icon: 'puzzle' as const,
    title: 'Config-driven',
    description: 'Add a model = one YAML block, no code change.',
  },
  {
    icon: 'rocket' as const,
    title: 'Async + sync',
    description: 'Upload to S3, Redis queue, or direct OpenAI-compatible proxy.',
  },
  {
    icon: 'sun' as const,
    title: 'LLM proxy',
    description: 'OpenAI / Anthropic / Ollama / vLLM with format translation.',
  },
  {
    icon: 'seti:db' as const,
    title: 'Response cache',
    description: 'Cache Redis exact-match, header X-Cache, TTL configurable.',
  },
  {
    icon: 'seti:lock' as const,
    title: 'Rate limiting + PII',
    description: 'Per consumer/user-type limits, email/IBAN/SIREN detection.',
  },
  {
    icon: 'magnifier' as const,
    title: 'Observability',
    description: 'Prometheus metrics, top-N consumers, KEDA autoscaling.',
  },
];
---

<div class="feature-grid">
  {features.map((f) => (
    <div class="feature-card">
      <Icon name={f.icon} size="1.5rem" />
      <h3>{f.title}</h3>
      <p>{f.description}</p>
    </div>
  ))}
</div>
